<!DOCTYPE html>
<%!-- Ambry is dark-only, everywhere: one theme, half the styling
      overhead. There is no theme machinery — every class is an absolute
      color, and color-scheme keeps native controls dark. --%>
<html lang="en" style="scrollbar-gutter: stable; color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" href={~p"/favicon.png"} sizes="16x16" />
    <link rel="icon" type="image/png" href={~p"/favicon-32x32.png"} sizes="32x32" />
    <link rel="icon" type="image/png" href={~p"/favicon-96x96.png"} sizes="96x96" />
    <.live_title suffix=" • Ambry">
      {assigns[:page_title] || "Personal Audiobook Streaming"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script :if={assigns[:global_id]} id="deep-link-script" data-global-id={@global_id}>
      // Attempt to open the Ambry mobile app via deep link
      (function() {
        var globalId = document.getElementById('deep-link-script').dataset.globalId;
        window.location = 'ambry://media/' + globalId;
      })();
    </script>
  </head>
  <body class="bg-black text-zinc-200 selection:bg-brand-dark selection:text-black">
    <%!-- Both branches are just the content: the document is the scroller
          everywhere. An `h-screen` shell whose child is `overflow-hidden`
          makes `#main-content` the scrollport instead, and LiveView only ever
          restores `window.scrollY`, so back from a book's page would land at
          the top of the library. --%>
    {@inner_content}
  </body>
</html>
