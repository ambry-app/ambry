<.layout title={@page_title} user={@current_user} jobs={@admin_jobs}>
  <div class="flex items-center">
    <div class="grow" />
    <.button color={:zinc} type="button" phx-click="reload">
      <.icon name="fa-rotate" class="mr-1.5 h-4 w-4 text-current" /> Reload
    </.button>
  </div>

  <%= if no_problems(@audit) do %>
    <p class="py-8 text-center text-lg font-semibold">
      No problems detected! 🎉
    </p>
  <% else %>
    <div class="space-y-14">
      <%= if @audit.orphaned_media_files != [] do %>
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-zinc-100">Orphaned audiobook files</h2>

          <p class="max-w-prose text-sm text-zinc-400">
            Nothing references these files; deleting them should be safe.
          </p>

          <div class="space-y-2 rounded-lg bg-zinc-900 p-4">
            <div
              :for={file <- @audit.orphaned_media_files}
              class="bg-zinc-800/60 flex items-center gap-3 rounded-md py-2 pr-2.5 pl-3"
            >
              <p class="font-mono min-w-0 grow truncate text-xs text-zinc-400">{file.path}</p>
              <span class="bg-white/10 rounded-sm px-2 py-0.5 text-xs tabular-nums text-zinc-300">
                {format_filesize(file.size)}
              </span>
              <button
                type="button"
                phx-click="delete-file"
                phx-value-id={file.id}
                data-confirm="Are you sure?"
                title="Delete this file"
              >
                <.icon name="fa-trash" class="h-4 w-4 cursor-pointer text-current transition-colors hover:text-red-400" />
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <%= if @audit.orphaned_source_folders != [] do %>
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-zinc-100">Orphaned source folders</h2>

          <p class="max-w-prose text-sm text-zinc-400">
            Nothing references these folders; deleting them should be safe.
          </p>

          <div class="space-y-2 rounded-lg bg-zinc-900 p-4">
            <div
              :for={folder <- @audit.orphaned_source_folders}
              class="bg-zinc-800/60 flex items-center gap-3 rounded-md py-2 pr-2.5 pl-3"
            >
              <p class="font-mono min-w-0 grow truncate text-xs text-zinc-400">{folder.path}</p>
              <span class="bg-white/10 rounded-sm px-2 py-0.5 text-xs tabular-nums text-zinc-300">
                {format_filesize(folder.size)}
              </span>
              <button
                type="button"
                phx-click="delete-folder"
                phx-value-id={folder.id}
                data-confirm="Are you sure?"
                title="Delete this folder"
              >
                <.icon name="fa-trash" class="h-4 w-4 cursor-pointer text-current transition-colors hover:text-red-400" />
              </button>
            </div>
          </div>
        </div>
      <% end %>

      <%= if @audit.broken_media != [] do %>
        <div class="space-y-4">
          <h2 class="text-xl font-bold text-zinc-100">Broken audiobooks</h2>

          <p class="max-w-prose text-sm text-zinc-400">
            These audiobooks have broken or incomplete files.
          </p>

          <div class="space-y-2 rounded-lg bg-zinc-900 p-4">
            <div
              :for={broken_media <- @audit.broken_media}
              class="bg-zinc-800/60 flex items-center gap-3 rounded-md py-2 pr-2.5 pl-3"
            >
              <div class="min-w-0 grow">
                <p class="truncate text-sm font-medium">{broken_media.media.book.title}</p>
                <p class="truncate text-xs text-zinc-400">
                  {Enum.map_join(broken_media.media.media_narrators, ", ", & &1.narrator.name)}
                </p>
              </div>
              <span class="flex flex-none gap-1.5">
                <.badge :if={!broken_media.mp4?} color={:red}>mp4</.badge>
                <.badge :if={!broken_media.mpd?} color={:red}>mpd</.badge>
                <.badge :if={!broken_media.hls_master?} color={:red}>hls</.badge>
                <.badge :if={!broken_media.hls_playlist?} color={:red}>hls_0</.badge>
                <.badge :if={!broken_media.source?} color={:yellow}>source</.badge>
              </span>
              <button type="button" phx-click="row-click" phx-value-id={broken_media.id} title="Open">
                <.icon name="fa-pencil" class="h-4 w-4 cursor-pointer text-current" />
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</.layout>
