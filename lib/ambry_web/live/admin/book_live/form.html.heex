<.layout title={@page_title} user={@current_user}>
  <.modal :if={@import} id="import-modal" show on_cancel={close_import_form(@book)}>
    <.live_component
      id="import-form"
      module={ProviderImportForm}
      provider={@import.provider}
      query={@import.query}
      book={@book}
    />
  </.modal>

  <div class="max-w-3xl">
    <.simple_form id="book-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <%!-- What the book is called and when it came out — the two facts that
          identify the work, in one block. --%>
      <.field_group>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-2">
          <.input field={@form[:title]} label="Title" />

          <div :if={@import_providers != []} class="row-start-1 space-y-2 sm:col-start-2">
            <.label class="pl-3">Import from</.label>
            <div class="flex flex-wrap items-center gap-2">
              <.button
                :for={provider <- @import_providers}
                color={:zinc}
                type="button"
                phx-click={open_import_form(@book, provider.id)}
              >
                {provider.display_name}
              </.button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-2">
          <.input field={@form[:published]} type="date" label="First print publication" />
          <div>
            <.input
              field={@form[:published_format]}
              type="select"
              label="Date display format"
              options={[{"Full Date", "full"}, {"Year & Month", "year_month"}, {"Year Only", "year"}]}
            />
            <span class="pl-3 text-sm text-zinc-400">
              {preview_date_format(@form)}
            </span>
          </div>
        </div>
      </.field_group>

      <.field_group label="Authors">
        <.inputs_for :let={book_author_form} field={@form[:book_authors]}>
          <.sort_input field={@form[:book_authors_sort]} index={book_author_form.index} />
          <.position_input field={book_author_form[:position]} index={book_author_form.index} />

          <div class="relative flex items-start gap-2">
            <.move_buttons
              :if={@book_author_count > 1}
              field={:book_authors}
              index={book_author_form.index}
              count={@book_author_count}
            />
            <div class="relative grow">
              <.input field={book_author_form[:author_id]} type="autocomplete" options={@authors} />
              <.delete_button
                field={@form[:book_authors_drop]}
                index={book_author_form.index}
                class="absolute top-3 right-2"
              />
            </div>
          </div>
        </.inputs_for>

        <:add>
          <.add_button field={@form[:book_authors_sort]}>Add author</.add_button>
          <.delete_input field={@form[:book_authors_drop]} />
        </:add>
      </.field_group>

      <.field_group label="Series">
        <.inputs_for :let={series_book_form} field={@form[:series_books]}>
          <.sort_input field={@form[:series_books_sort]} index={series_book_form.index} />
          <.position_input field={series_book_form[:position]} index={series_book_form.index} />

          <div class="relative flex items-start gap-2">
            <.move_buttons
              :if={@series_book_count > 1}
              field={:series_books}
              index={series_book_form.index}
              count={@series_book_count}
            />
            <.input
              field={series_book_form[:book_number]}
              placeholder="no."
              container_class="w-14 flex-none"
              show_errors={false}
            />
            <.input
              field={series_book_form[:series_id]}
              type="autocomplete"
              options={@series}
              container_class="grow"
            />
            <.delete_button
              field={@form[:series_books_drop]}
              index={series_book_form.index}
              class="absolute top-3 right-2"
            />
          </div>
        </.inputs_for>

        <:add>
          <.add_button field={@form[:series_books_sort]}>Add series</.add_button>
          <.delete_input field={@form[:series_books_drop]} />
        </:add>
      </.field_group>

      <.field_group label="Universes">
        <.inputs_for :let={book_universe_form} field={@form[:book_universes]}>
          <.sort_input field={@form[:book_universes_sort]} index={book_universe_form.index} />

          <div class="relative">
            <.input field={book_universe_form[:universe_id]} type="autocomplete" options={@universes} />
            <.delete_button
              field={@form[:book_universes_drop]}
              index={book_universe_form.index}
              class="absolute top-3 right-2"
            />
          </div>
        </.inputs_for>

        <:add>
          <.add_button field={@form[:book_universes_sort]}>Add universe</.add_button>
          <.delete_input field={@form[:book_universes_drop]} />
        </:add>
      </.field_group>

      <.provenance_panel
        record={@book}
        changeset={@form.source}
        pending_sources={ProvenanceHints.sources(@provenance_hints)}
      />

      <:actions>
        <.button>Save</.button>
      </:actions>
    </.simple_form>
  </div>
</.layout>
