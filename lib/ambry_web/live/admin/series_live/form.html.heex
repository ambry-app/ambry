<.layout title={@page_title} user={@current_user} socket={@socket}>
  <div class="-mb-4 max-w-4xl">
    <.simple_form id="series-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.field_group>
        <.input field={@form[:name]} label="Name" class="max-w-xl" />
      </.field_group>

      <.list_cluster label="Books">
        <.inputs_for :let={series_book_form} field={@form[:series_books]}>
          <.sort_input field={@form[:series_books_sort]} index={series_book_form.index} />

          <div class="flex items-start gap-2">
            <.input
              field={series_book_form[:book_number]}
              placeholder="no."
              container_class="w-14 flex-none"
              show_errors={false}
            />
            <.input
              field={series_book_form[:book_id]}
              type="autocomplete"
              search={&Books.search_books/2}
              fetch={&Books.book_option/1}
              container_class="grow"
            />
            <.delete_button
              field={@form[:series_books_drop]}
              index={series_book_form.index}
            />
          </div>
        </.inputs_for>

        <:add>
          <.add_button field={@form[:series_books_sort]}>Add book</.add_button>
          <.delete_input field={@form[:series_books_drop]} />
        </:add>
      </.list_cluster>

      <.form_footer>
        <.button>Save</.button>

        <:danger :if={@live_action == :edit}>
          <.button
            type="button"
            color={:red}
            phx-click="delete"
            data-confirm="Delete this series? Its books stay in the library and lose their numbers in it."
            data-role="delete-series"
          >
            Delete
          </.button>
        </:danger>
      </.form_footer>
    </.simple_form>
  </div>
</.layout>
