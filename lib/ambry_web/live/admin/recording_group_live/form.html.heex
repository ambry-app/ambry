<.layout title={@page_title} user={@current_user}>
  <div class="max-w-3xl">
    <.simple_form id="group-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.input field={@form[:name]} label="Name" container_class="max-w-md" />

      <.input
        field={@form[:parts_total]}
        type="number"
        min="1"
        label="Total releases in the set (optional)"
        container_class="max-w-48"
      />

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-2">
        <.input
          field={@form[:part_word]}
          label={~s(What's one release called? — default "part")}
          placeholder="part"
        />
        <.input
          field={@form[:part_word_plural]}
          label={~s(…and several? — default "parts")}
          placeholder="parts"
        />
      </div>

      <.input
        field={@form[:show_label]}
        type="checkbox"
        label="Show the group's name to listeners on this set's stacked tile"
      />

      <div :if={@group.id} class="space-y-2">
        <.label>Recordings in this set</.label>
        <p :if={@group.media == []} class="pl-3 text-sm text-zinc-400">
          None yet — attach recordings from their media pages or the import form.
        </p>
        <div :for={media <- @group.media} class="rounded-lg bg-zinc-800 p-3" data-role="group-member">
          <.brand_link navigate={~p"/admin/media/#{media}/edit"}>
            {member_label(media, @group)}
          </.brand_link>
        </div>
        <p class="pl-3 text-sm text-zinc-400">
          Part numbers are edited on each recording's own page.
        </p>
      </div>

      <:actions>
        <.button>Save</.button>
      </:actions>
    </.simple_form>
  </div>
</.layout>
