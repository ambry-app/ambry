<.layout title={@page_title} user={@current_user}>
  <.datalist id="books" options={@books} />

  <div class="max-w-3xl">
    <.simple_form id="universe-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.input field={@form[:name]} label="Name" />

      <div class="space-y-2">
        <.label>Books</.label>
        <.inputs_for :let={book_universe_form} field={@form[:book_universes]}>
          <.sort_input field={@form[:book_universes_sort]} index={book_universe_form.index} />

          <div class="relative">
            <.input field={book_universe_form[:book_id]} type="autocomplete" options={@books} list="books" />
            <.delete_button
              field={@form[:book_universes_drop]}
              index={book_universe_form.index}
              class="absolute top-3 right-2"
            />
          </div>
        </.inputs_for>

        <.add_button field={@form[:book_universes_sort]}>Add book</.add_button>
        <.delete_input field={@form[:book_universes_drop]} />
      </div>

      <:actions>
        <.button>Save</.button>
      </:actions>
    </.simple_form>
  </div>
</.layout>
