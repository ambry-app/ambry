<.layout title={@page_title} user={@current_user} socket={@socket}>
  <div class="-mb-4 max-w-4xl">
    <.simple_form id="universe-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.field_group>
        <.input field={@form[:name]} label="Name" class="max-w-xl" />
      </.field_group>

      <.field_group label="Books">
        <.inputs_for :let={book_universe_form} field={@form[:book_universes]}>
          <.sort_input field={@form[:book_universes_sort]} index={book_universe_form.index} />

          <div class="flex items-start gap-2">
            <.input
              field={book_universe_form[:book_id]}
              type="autocomplete"
              search={&Books.search_books/2}
              fetch={&Books.book_option/1}
              container_class="grow"
            />
            <.delete_button
              field={@form[:book_universes_drop]}
              index={book_universe_form.index}
            />
          </div>
        </.inputs_for>

        <:add>
          <.add_button field={@form[:book_universes_sort]}>Add book</.add_button>
          <.delete_input field={@form[:book_universes_drop]} />
        </:add>
      </.field_group>

      <.form_footer>
        <.button>Save</.button>

        <:danger :if={@live_action == :edit}>
          <.button
            type="button"
            color={:red}
            phx-click="delete"
            data-confirm="Delete this universe? Its books stay in the library."
            data-role="delete-universe"
          >
            Delete
          </.button>
        </:danger>
      </.form_footer>
    </.simple_form>
  </div>
</.layout>
