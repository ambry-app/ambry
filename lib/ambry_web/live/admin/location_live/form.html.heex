<.layout title={@page_title} user={@current_user} jobs={@admin_jobs}>
  <div class="-mb-4 max-w-4xl">
    <.simple_form id="location-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.field_group>
        <.input field={@form[:name]} label="Name" class="max-w-xl" />

        <.input
          field={@form[:path]}
          label="Path"
          placeholder={(@type == :source && "/data/downloads") || "/data/library"}
        />

        <p
          :if={@status && !@status.exists?}
          class="pl-3 text-sm text-amber-400"
          data-role="path-status"
        >
          Nothing at that path right now. You can still save it and mount the volume later.
        </p>

        <p
          :if={@status && @status.exists? && !@status.directory?}
          class="pl-3 text-sm text-red-400"
          data-role="path-status"
        >
          That's a file, not a folder.
        </p>

        <p
          :if={@status && @status.directory? && !@status.writable? && @type == :root}
          class="pl-3 text-sm text-amber-400"
          data-role="path-status"
        >
          That folder is read-only, so nothing can be imported into it.
        </p>

        <p
          :if={@status && @status.directory? && (@status.writable? || @type == :source)}
          class="pl-3 text-sm text-lime-400"
          data-role="path-status"
        >
          Folder found.
        </p>
      </.field_group>

      <.field_group :if={@type == :source}>
        <.input field={@form[:enabled]} type="checkbox" label="Watched" />
      </.field_group>

      <.form_footer>
        <.button>Save</.button>
      </.form_footer>
    </.simple_form>
  </div>
</.layout>
