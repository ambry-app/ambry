<.layout title={@page_title} user={@current_user}>
  <div class="max-w-3xl">
    <.simple_form id="location-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.input field={@form[:name]} label="Name" />

      <div>
        <.input
          field={@form[:path]}
          label="Path"
          placeholder={(@type == :source && "/data/downloads") || "/data/library"}
        />

        <p
          :if={@status && !@status.exists?}
          class="mt-2 text-sm text-amber-400"
          data-role="path-status"
        >
          Nothing at that path right now. You can still save it — a volume that isn't mounted yet
          is a normal thing to configure ahead of time.
        </p>

        <p
          :if={@status && @status.exists? && !@status.directory?}
          class="mt-2 text-sm text-red-400"
          data-role="path-status"
        >
          That's a file, not a folder.
        </p>

        <p
          :if={@status && @status.directory? && !@status.writable? && @type == :root}
          class="mt-2 text-sm text-amber-400"
          data-role="path-status"
        >
          That folder is read-only, so nothing can be imported into it.
        </p>

        <p
          :if={@status && @status.directory? && (@status.writable? || @type == :source)}
          class="mt-2 text-sm text-lime-400"
          data-role="path-status"
        >
          Folder found.
        </p>
      </div>

      <div :if={@type == :source}>
        <.input
          field={@form[:on_import]}
          type="select"
          label="On import"
          options={on_import_options()}
        />
        <p class="mt-2 text-sm text-zinc-400">
          The one promise a source makes. A folder a download client controls can lose its files,
          so the library protects itself with its own copy; a collection that's staying put is
          simply pointed at, and Ambry never writes to it.
        </p>
      </div>

      <div :if={@type == :source and @on_import == :bring_in} class="space-y-6">
        <div>
          <.input
            field={@form[:import_policy]}
            type="select"
            label="How the files come in"
            options={policy_options()}
          />
          <p class="mt-2 text-sm text-zinc-400">
            Hardlinking only works within a single filesystem. If this folder and the library root
            it imports into are on different disks, import will say so rather than quietly
            copying and doubling your storage.
          </p>
        </div>

        <div>
          <.input
            field={@form[:target_root_id]}
            type="select"
            label="Preferred library root"
            options={@root_options}
            prompt={root_prompt(@root_options)}
          />
          <p class="mt-2 text-sm text-zinc-400">
            Optional. Any source can import into any root — this only preselects one. With
            a single root, imports never ask.
          </p>
          <p :if={@root_options == []} class="mt-2 text-sm text-amber-400">
            There are no library roots yet, so nothing can be brought in. Add one under
            Locations first — until then, importing an item from this folder will refuse.
          </p>
        </div>
      </div>

      <.input :if={@type == :source} field={@form[:enabled]} type="checkbox" label="Watched" />

      <:actions>
        <.button>Save</.button>
      </:actions>
    </.simple_form>
  </div>
</.layout>
