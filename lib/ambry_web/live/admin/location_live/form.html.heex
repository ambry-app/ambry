<.layout title={@page_title} user={@current_user}>
  <div class="-mb-4 max-w-4xl">
    <.simple_form id="location-form" for={@form} phx-change="validate" phx-submit="submit" autocomplete="off">
      <.field_group>
        <.input field={@form[:name]} label="Name" class="max-w-xl" />

        <.input
          field={@form[:path]}
          label="Path"
          placeholder={(@type == :source && "/data/downloads") || "/data/library"}
        />

        <p
          :if={@status && !@status.exists?}
          class="pl-3 text-sm text-amber-400"
          data-role="path-status"
        >
          Nothing at that path right now. You can still save it and mount the volume later.
        </p>

        <p
          :if={@status && @status.exists? && !@status.directory?}
          class="pl-3 text-sm text-red-400"
          data-role="path-status"
        >
          That's a file, not a folder.
        </p>

        <p
          :if={@status && @status.directory? && !@status.writable? && @type == :root}
          class="pl-3 text-sm text-amber-400"
          data-role="path-status"
        >
          That folder is read-only, so nothing can be imported into it.
        </p>

        <p
          :if={@status && @status.directory? && (@status.writable? || @type == :source)}
          class="pl-3 text-sm text-lime-400"
          data-role="path-status"
        >
          Folder found.
        </p>
      </.field_group>

      <.field_group :if={@type == :source}>
        <.input
          field={@form[:on_import]}
          type="select"
          label="On import"
          options={on_import_options()}
        />
        <p class="max-w-prose pl-3 text-sm text-zinc-400">
          Whether import copies these files into the library or references them where they
          are.
        </p>

        <.input field={@form[:enabled]} type="checkbox" label="Watched" />
      </.field_group>

      <.field_group :if={@type == :source and @on_import == :bring_in} label="Bringing files in">
        <div>
          <.input
            field={@form[:import_policy]}
            type="select"
            label="How the files come in"
            options={policy_options()}
          />
          <p class="max-w-prose pl-3 text-sm text-zinc-400">
            Hardlinking only works within a single filesystem. Import refuses across
            filesystems instead of silently copying.
          </p>
        </div>

        <div>
          <.input
            field={@form[:target_root_id]}
            type="select"
            label="Preferred library root"
            options={@root_options}
            prompt={root_prompt(@root_options)}
          />
          <p class="max-w-prose pl-3 text-sm text-zinc-400">
            Optional. Any source can import into any root; this preselects one.
          </p>
          <p :if={@root_options == []} class="max-w-prose pl-3 text-sm text-amber-400">
            No library roots yet, so nothing can be brought in. Add one under Locations
            first.
          </p>
        </div>
      </.field_group>

      <.form_footer>
        <.button>Save</.button>
      </.form_footer>
    </.simple_form>
  </div>
</.layout>
