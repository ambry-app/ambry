<.layout title={@page_title} user={@current_user} socket={@socket}>
  <div class="max-w-4xl space-y-14">
    <section class="space-y-3">
      <%!-- Beside the heading it acts on, not marooned in the page header:
          on a wide window that put it a thousand pixels from anything it
          had an effect on. --%>
      <div class="flex flex-wrap items-center gap-3">
        <h2 class="text-xl font-bold text-zinc-100">Sources</h2>
        <.button :if={@sources != []} phx-click="scan" color={:zinc} size={:sm}>
          Scan all
        </.button>
      </div>

      <div :if={@sources == []} class="rounded-lg bg-zinc-900 p-8 text-center">
        <p class="text-zinc-400">No sources yet, so there is nothing to scan.</p>
        <.add_button navigate={~p"/admin/locations/sources/new"} class="mx-auto mt-3">
          Add the first one
        </.add_button>
      </div>

      <div :for={source <- @sources} class="rounded-lg bg-zinc-900 p-4" data-role="source">
        <div class="flex items-start gap-3">
          <div class="min-w-0 grow pl-3">
            <div class="flex flex-wrap items-baseline gap-2">
              <h3 class="font-semibold" data-role="source-name">{source.name}</h3>

              <span
                :if={fs = filesystem_tag(@filesystems, @statuses[{:source, source.id}])}
                class="bg-white/10 rounded-sm px-1.5 text-xs text-zinc-300"
                title="Paths sharing this tag can be hardlinked between"
                data-role="source-filesystem"
              >
                <.icon name="fa-hard-drive" class="h-3 w-3 text-current" /> {fs}
              </span>

              <span :if={!source.enabled} class="bg-white/10 rounded-sm px-1.5 text-xs text-zinc-500">
                paused
              </span>
            </div>

            <p class="font-mono mt-1 truncate text-sm text-zinc-400" data-role="source-path">
              {source.path}
            </p>

            <p
              :if={problem = source_problem(@statuses[{:source, source.id}])}
              class="mt-1 text-sm font-semibold text-red-400"
              data-role="source-problem"
            >
              {problem}
            </p>

            <p class="mt-1 text-xs text-zinc-500">
              {scanned_label(source.last_scanned_at)}
            </p>
          </div>

          <%!-- Worded, like every other card's actions: an unlabeled 16px
                glyph is neither a label nor a touch target, and "the eye"
                never said which way it was about to go. --%>
          <div class="flex flex-none flex-wrap justify-end gap-1.5">
            <.row_action
              icon={(source.enabled && "fa-eye-slash") || "fa-eye"}
              phx-click="toggle"
              phx-value-id={source.id}
              title={(source.enabled && "Stop scanning this folder") || "Scan this folder again"}
              data-role="toggle-source"
            >
              {(source.enabled && "Pause") || "Resume"}
            </.row_action>

            <.row_action
              navigate={~p"/admin/locations/sources/#{source}/edit"}
              icon="fa-pencil"
              data-role="edit-source"
            >
              Edit
            </.row_action>

            <.row_action
              icon="fa-trash"
              color={:red}
              phx-click="delete-source"
              phx-value-id={source.id}
              data-confirm="Remove this source? Files on disk are left alone."
              data-role="delete-source"
            >
              Remove
            </.row_action>
          </div>
        </div>
      </div>

      <.add_button navigate={~p"/admin/locations/sources/new"}>Add source</.add_button>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-bold text-zinc-100">Library roots</h2>

      <%!-- Roots are mandatory: every import places into one, so an empty
          section is a blocker, not a fine choice. --%>
      <div :if={@roots == []} class="rounded-lg bg-zinc-900 p-8 text-center">
        <p class="mx-auto max-w-prose text-zinc-400">
          No roots yet. Nothing can be imported until there is one.
        </p>
        <.add_button navigate={~p"/admin/locations/roots/new"} class="mx-auto mt-3">
          Add a root
        </.add_button>
      </div>

      <div :for={root <- @roots} class="rounded-lg bg-zinc-900 p-4" data-role="root">
        <div class="flex items-start gap-3">
          <div class="min-w-0 grow pl-3">
            <div class="flex flex-wrap items-baseline gap-2">
              <h3 class="font-semibold" data-role="root-name">{root.name}</h3>

              <span
                :if={fs = filesystem_tag(@filesystems, @statuses[{:root, root.id}])}
                class="bg-white/10 rounded-sm px-1.5 text-xs text-zinc-300"
                title="Paths sharing this tag can be hardlinked between"
                data-role="root-filesystem"
              >
                <.icon name="fa-hard-drive" class="h-3 w-3 text-current" /> {fs}
              </span>
            </div>

            <p class="font-mono mt-1 truncate text-sm text-zinc-400" data-role="root-path">
              {root.path}
            </p>

            <p
              :if={problem = root_problem(@statuses[{:root, root.id}])}
              class="mt-1 text-sm font-semibold text-red-400"
              data-role="root-problem"
            >
              {problem}
            </p>
          </div>

          <div class="flex flex-none flex-wrap justify-end gap-1.5">
            <.row_action
              navigate={~p"/admin/locations/roots/#{root}/edit"}
              icon="fa-pencil"
              data-role="edit-root"
            >
              Edit
            </.row_action>

            <.row_action
              icon="fa-trash"
              color={:red}
              phx-click="delete-root"
              phx-value-id={root.id}
              data-confirm="Remove this root? Files on disk are left alone."
              data-role="delete-root"
            >
              Remove
            </.row_action>
          </div>
        </div>
      </div>

      <.add_button navigate={~p"/admin/locations/roots/new"}>Add root</.add_button>
    </section>
  </div>
</.layout>
