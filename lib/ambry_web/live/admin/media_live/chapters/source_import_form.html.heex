<div class="mx-auto max-w-3xl space-y-7 p-6">
  <div>
    <h2 class="text-xl font-bold text-zinc-100">Re-read the files</h2>
    <p class="max-w-prose pt-1 text-sm text-zinc-400">
      What the audio itself says about its chapters. This is the same reading the scanner does, so
      it is what a fresh import of these files would produce.
    </p>
  </div>

  <.async_result :let={read} assign={@read}>
    <:loading>
      <.loading>Reading the files…</.loading>
    </:loading>

    <:failed :let={failure}>
      <.error>{failure}</.error>
    </:failed>

    <div :if={read.chapters == []} class="space-y-2">
      <p class="text-sm text-zinc-400">
        These files carry no chapter marks, and there is more than nothing only when a release is
        split file-per-chapter. Nothing here to import.
      </p>
    </div>

    <div :if={read.chapters != []} class="space-y-7">
      <.chapter_preview chapters={read.chapters} source={read.marker_source} />

      <div class="flex flex-wrap items-center gap-2">
        <.button type="button" phx-click="import-all" phx-target={@myself}>
          Take markers and titles
        </.button>
        <.button
          :if={@markers != []}
          type="button"
          color={:zinc}
          phx-click="import-markers"
          phx-target={@myself}
          title="Correct the timeline, keeping the titles already on this recording"
        >
          Markers only — keep my titles
        </.button>
        <.button type="button" color={:zinc} phx-click={JS.exec("data-cancel", to: "#import-modal")}>
          Cancel
        </.button>
      </div>
    </div>
  </.async_result>
</div>
