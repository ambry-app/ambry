<div class="mx-auto max-w-3xl space-y-7 p-6">
  <div>
    <h2 class="text-xl font-bold text-zinc-100">Chapter titles from Audible</h2>
    <p class="max-w-prose pt-1 text-sm text-zinc-400">
      Only the titles are taken. Audible's chapter times describe its own edition and drift against
      a rip, so they are used to work out which title belongs to which of your markers and then
      discarded.
    </p>
  </div>

  <.simple_form for={@search_form} phx-submit="search" phx-target={@myself}>
    <div class="flex items-end gap-2">
      <.input field={@search_form[:query]} label="Search" container_class="grow" />
      <.button>Search</.button>
      <.button color={:zinc} name="refresh" value="true" title="Bypass cached results and re-fetch">
        Re-fetch
      </.button>
    </div>
  </.simple_form>

  <.async_result :let={books} assign={@books}>
    <:loading>
      <.loading>Searching books...</.loading>
    </:loading>

    <:failed :let={failure}>
      <.error>There was an error searching Audible for books: {failure}</.error>
    </:failed>

    <.simple_form id="select-book-form" for={@select_book_form} phx-change="select-book" phx-target={@myself}>
      <div class="space-y-2">
        <.label class="pl-3">Select book ({length(books)} results)</.label>
        <.rich_select id="book-select" field={@select_book_form[:book_id]} options={books}>
          <:option :let={book}>
            <.book_card book={book} />
          </:option>
        </.rich_select>
      </div>
    </.simple_form>

    <.async_result :let={chapters} :if={@books.ok?} assign={@chapters}>
      <:loading>
        <.loading>Fetching chapters...</.loading>
      </:loading>

      <:failed :let={failure}>
        <.error>There was an error fetching chapters from Audible: {failure}</.error>
      </:failed>

      <div :if={@markers == []} class="space-y-2">
        <p class="max-w-prose text-sm text-zinc-400">
          This recording has no markers yet, and titles have nowhere to land without them. Read the
          chapter marks off the files first — or, if the files carry none, add the rows by hand.
        </p>
      </div>

      <div :if={@markers != []} class="space-y-7">
        <.alignment_preview
          markers={@markers}
          incoming={preview_incoming(chapters)}
          alignment={preview_alignment(@markers, chapters)}
          summary={preview_summary(@markers, chapters)}
        />

        <div class="flex flex-wrap items-center gap-2">
          <.button type="button" phx-click="import" phx-target={@myself}>Take these titles</.button>
          <.button type="button" color={:zinc} phx-click={JS.exec("data-cancel", to: "#import-modal")}>
            Cancel
          </.button>
        </div>
      </div>
    </.async_result>
  </.async_result>
</div>
