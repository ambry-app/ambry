<.layout title={@page_title} user={@current_user} socket={@socket}>
  <div class="max-w-4xl">
    <div class="space-y-2 rounded-lg bg-zinc-900 p-4">
      <.simple_form
        id="watch-search-form"
        for={@search_form}
        as={:search}
        phx-submit="search"
        container_class="space-y-2"
      >
        <div class="flex flex-wrap items-end gap-2">
          <.input field={@search_form[:title]} label="Title" container_class="w-48" />
          <.input field={@search_form[:author]} label="Author" container_class="w-48" />
          <.input field={@search_form[:narrator]} label="Narrator" container_class="w-48" />

          <.button color={:zinc} type="submit" disabled={@searching}>
            {(@searching && "Searching…") || "Search"}
          </.button>
        </div>
      </.simple_form>

      <.provider_outcomes_row outcomes={@outcomes} retryable={false} />

      <p :for={note <- @notes} class="pl-3 text-sm text-zinc-400">{note}</p>

      <p :if={@searched and @candidates == []} class="pl-3 text-sm text-zinc-400">
        Nothing came back that is still to come. Try different words.
      </p>

      <div
        :for={candidate <- @candidates}
        class="bg-zinc-800/60 flex items-start gap-4 rounded-md p-3"
        data-role="watch-candidate"
      >
        <.row_cover src={candidate.edition.cover_url} />

        <div class="min-w-0 grow">
          <div class="flex items-baseline gap-2">
            <span class="min-w-0 truncate font-semibold text-zinc-100">
              {candidate.edition.title}
            </span>

            <.badge color={:gray} class="flex-none text-xs font-normal" data-role="record-source">
              {provider_words(candidate.provider)}
            </.badge>
          </div>

          <.credit_lines
            authors={credited(candidate.edition.authors)}
            narrators={credited(candidate.edition.narrators)}
          />

          <p class="truncate pt-1 text-sm text-zinc-400" data-role="candidate-facts">
            {candidate_facts(candidate)}
          </p>
        </div>

        <.button
          color={:zinc}
          size={:sm}
          phx-click="watch"
          phx-value-provider={candidate.provider}
          phx-value-provider-id={candidate.provider_id}
          data-role="watch-this"
        >
          Watch
        </.button>
      </div>
    </div>
  </div>
</.layout>
