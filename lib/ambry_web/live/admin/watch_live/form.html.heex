<.layout title={@page_title} user={@current_user} socket={@socket}>
  <div class="-mb-4 max-w-4xl">
    <.simple_form id="watch-form" for={@form} as={:watch} phx-change="validate" phx-submit="save">
      <.field_group>
        <div class="flex items-start gap-4 pl-3">
          <.row_cover src={@watch.edition.cover_url} />

          <div class="min-w-0">
            <p class="font-semibold text-zinc-100">{@watch.edition.title}</p>
            <.credit_lines
              authors={credited(@watch.edition.authors)}
              narrators={credited(@watch.edition.narrators)}
            />
            <p class="pt-1 text-sm text-zinc-500">
              {provider_words(@watch.provider)} · {@watch.provider_id}
              <span :if={runtime(@watch.edition)}>· {runtime(@watch.edition)}</span>
              <span :if={@watch.edition.publisher}>· {@watch.edition.publisher}</span>
            </p>
          </div>
        </div>
      </.field_group>

      <.field_group>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-2">
          <.input field={@form[:expected_release_date]} type="date" label="Expected" />
          <.input field={@form[:status]} type="select" label="State" options={status_options()} />
        </div>

        <.input field={@form[:note]} type="textarea" label="Note" rows="3" />
      </.field_group>

      <.form_footer>
        <.button>Save</.button>

        <:danger>
          <.button
            type="button"
            color={:red}
            phx-click="delete"
            data-confirm={"Forget \"#{@watch.edition.title}\"? Nothing will record that you decided about it. Dismissing keeps that record."}
            data-role="delete-watch"
          >
            Forget
          </.button>
        </:danger>
      </.form_footer>
    </.simple_form>
  </div>
</.layout>
